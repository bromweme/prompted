# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# SQLite data files
*.db
*.db-wal
*.db-shm

# Local env files. web-app/.gitignore already covers its own; server/ loads
# one via dotenv and had nothing ignoring it, so a real secret dropped there
# would have been committed.
.env
.env.*
!.env.example

# Scratch files that aren't part of this project
verify_skills.mjs

# Generated by the dependency-audit job (and by anyone running `npm sbom`
# locally). The record that matters is the CI artifact, tied to a commit.
sbom-*.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
