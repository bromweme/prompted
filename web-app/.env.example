# Copy to web-app/.env and fill in. web-app/.env is gitignored.

VITE_SOCKET_URL=http://localhost:5000

# The same OAuth 2.0 Web client ID the server verifies against.
# This one is public by design - it ships in the browser bundle.
# The client *secret* is never needed and must not be put here.
VITE_GOOGLE_CLIENT_ID=
