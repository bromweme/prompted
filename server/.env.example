# Copy to server/.env and fill in. server/.env is gitignored; never commit real values.

# --- Google Sign-In ---------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# Application type: "Web application".
# Authorized JavaScript origins must include http://localhost:5173
# No redirect URI and no client secret are needed: Google Identity Services
# returns the ID token to the browser, and we verify it here.
GOOGLE_CLIENT_ID=

# --- YouTube Data API v3 ----------------------------------------------------
# Google Cloud Console -> Library -> enable "YouTube Data API v3",
# then Credentials -> Create credentials -> API key.
# Restrict the key to the YouTube Data API v3, and to this server's IP.
# Quota: 10,000 units/day, and search.list costs 100 units per call.
YOUTUBE_API_KEY=

# --- Sessions ---------------------------------------------------------------
# Signs our own session tokens so players are not re-prompted on reconnect
# (Google ID tokens last about an hour, far too short for that).
# Generate with:  openssl rand -hex 32
SESSION_SECRET=

# Optional
PORT=5000
SESSION_TTL_DAYS=30

# Test-only. Lets the Playwright suite mint sessions without calling Google.
# Refused outright when NODE_ENV=production - the server will not boot.
# AUTH_TEST_MODE=1
