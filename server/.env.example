# Copy to server/.env and fill in. server/.env is gitignored; never commit real values.

# --- Google Sign-In ---------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# Application type: "Web application".
# Authorized JavaScript origins must include http://localhost:5173
# No redirect URI and no client secret are needed: Google Identity Services
# returns the ID token to the browser, and we verify it here.
GOOGLE_CLIENT_ID=

# --- YouTube Data API v3 ----------------------------------------------------
# Google Cloud Console -> Library -> enable "YouTube Data API v3",
# then Credentials -> Create credentials -> API key.
# Restrict the key to the YouTube Data API v3, and to this server's IP.
# Quota: 10,000 units/day, and search.list costs 100 units per call.
YOUTUBE_API_KEY=

# --- Sessions ---------------------------------------------------------------
# Signs our own session tokens so players are not re-prompted on reconnect
# (Google ID tokens last about an hour, far too short for that).
# Generate with:  openssl rand -hex 32
SESSION_SECRET=

# --- Allowed browser origins ---------------------------------------------------
# Comma-separated list of origins the HTTP API and the socket.io handshake will
# accept cross-origin requests from. Leave unset for local development: the
# server falls back to the localhost dev origins
# (http://localhost:3000, :5173, :8081, exp://localhost:19000).
# In production this MUST be set to the real deployed web origin(s), e.g.:
#   ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
# ALLOWED_ORIGINS=

# --- Database (DB-1) --------------------------------------------------------
# Unset, the server stores everything in server/prompted.db (SQLite), which is
# what a local checkout wants: no setup, no account, nothing to run.
#
# Set, the server stores everything in Postgres instead. Production MUST set
# it: a hosted filesystem is usually ephemeral, so a local file is destroyed on
# every restart, redeploy and idle spin-down - taking every group with it.
# Get the connection string from your provider (e.g. Neon) and prefer its
# pooled endpoint. TLS certificate verification stays on for any non-local
# host; PGSSL_NO_VERIFY=1 turns it off, which you only want for a self-signed
# local instance.
#   DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# DATABASE_URL=
#
# Namespaces the tables. The suites set their own per-run value so concurrent
# runs can share one database; leave it unset in production.
# DATABASE_SCHEMA=

# --- Event log actor ids (EVT-1) --------------------------------------------
# Pseudonymises the acting user in the event log: rows store an HMAC of the
# user id, never the id itself. Set it once and leave it alone - the same
# player only hashes to the same actor id for as long as this value does not
# change, and changing it renames every actor in the log. It used to be
# generated into the database, which meant a new secret (and a new set of
# actor ids) every time the database was wiped.
# Generate with:  openssl rand -hex 32
EVENTS_HASH_SECRET=

# Optional
PORT=5000
SESSION_TTL_DAYS=30
# PGPOOL_MAX=5

# Test-only. Lets the Playwright suite mint sessions without calling Google.
# Refused outright when NODE_ENV=production - the server will not boot.
# AUTH_TEST_MODE=1
